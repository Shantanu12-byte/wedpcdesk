{
  "name": "webpcdeck-root",
  "version": "1.0.0",
  "description": "Macro Deck Desktop Control Application",
  "main": "main.js",
  "scripts": {
    "install-all": "npm install && npm install --prefix backend && npm install --prefix frontend",
    "predev": "powershell -Command \"try { $conn = Get-NetTCPConnection -LocalPort 5001 -ErrorAction SilentlyContinue; if ($conn) { Stop-Process -Id $conn.OwningProcess -Force -ErrorAction SilentlyContinue; Write-Output 'Killed orphaned process on port 5001' } } catch {} exit 0\"",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\" \"wait-on tcp:5173 && electron .\"",
    "start": "electron .",
    "build:frontend": "npm run build --prefix frontend",
    "build": "npm install --prefix frontend && npm run build:frontend",
    "package": "electron-builder build --win --x64"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "uuid": "^10.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.9",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.5.10",
    "concurrently": "^8.2.2",
    "electron": "^31.3.1",
    "electron-builder": "^26.15.3",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.webpcdeck.app",
    "productName": "WebPCDeck",
    "asar": true,
    "asarUnpack": [
      "ngrok.exe",
      "backend/src/smtc_bridge.exe"
    ],
    "directories": {
      "output": "dist-app"
    },
    "files": [
      "main.js",
      "package.json",
      "tray_icon.png",
      "ngrok.exe",
      ".env.local",
      "shared/**/*",
      "backend/dist/**/*",
      "backend/src/smtc_bridge.exe",
      "backend/package.json",
      "backend/node_modules/**/*",
      "!backend/node_modules/webpcdeck-root",
      "frontend/dist/**/*"
    ],
    "win": {
      "target": "portable"
    }
  }
}
